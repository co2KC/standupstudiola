{
  // Cloudflare Workers, static assets only. Payments and signup run as Supabase Edge Functions.
  "name": "standupstudiola",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Old WordPress links (for example /group-classes/) land on the home page instead of an error.
    "not_found_handling": "single-page-application"
  }
}
